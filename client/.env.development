# Muvy Client Environment Variables - DEVELOPMENT
# This file is used for local development and testing
# COPY THIS FILE TO .env AND ADD YOUR REAL API KEYS

# Server URL for Socket.IO connection (local server)
VITE_SERVER_URL=http://localhost:3001

# Google Drive Integration
# Get these from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Dropbox Integration  
# Get this from: https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=your_dropbox_app_key_here
