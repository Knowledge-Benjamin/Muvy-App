# Muvy Client Environment Variables - PRODUCTION (EXAMPLE)
# Copy this file to .env.production and add your real API keys

# Server URL for Socket.IO connection (Render production server)
VITE_SERVER_URL=https://muvy-app.onrender.com

# Google Drive Integration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Dropbox Integration
VITE_DROPBOX_APP_KEY=your_dropbox_app_key_here
